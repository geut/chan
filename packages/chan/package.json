{
  "name": "@geut/chan",
  "version": "3.2.9",
  "description": "Write and maintain a CHANGELOG from your command line.",
  "homepage": "http://geutstudio.com",
  "license": "ISC",
  "author": {
    "name": "GEUT",
    "email": "contact@geutstudio.com"
  },
