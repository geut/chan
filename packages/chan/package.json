  "bin": {
    "chan": "./bin/chan.js"
  },
  "files": [
    "dist/src/",
    "src/"
  ],
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "chan": "./dist/src/bin.js"
    },
    "exports": {
      ".": {
        "import": "./dist/src/index.js",
        "types": "./dist/src/index.d.ts"
      }
    },
    "module": "./dist/src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint",
    "check-types": "tsgo --noEmit",
    "build": "tsgo --build"
  },
  "dependencies": {
    "@actions/github": "^5.0.0",
    "@geut/chan-core": "^3.2.7", 
    "@geut/chan-ai": "^1.0.0",
    "@geut/git-url-parse": "^3.2.6",
    "boxen": "^5.0.1",
    "editor": "^1.0.0",
    "find-up": "^8.0.0",
    "new-github-release-url": "^1.0.0",
    "open": "^8.2.0",
    "semver": "^7.3.5",
    "signale": "^1.4.0",
    "tempfile": "^4.0.0",
    "to-vfile": "^8.0.0",
    "yargs": "^17.0.1"
  },
  "devDependencies": {
    "@types/signale": "^1.4.7",
    "to-vfile": "^8.0.0",
    "vfile": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}