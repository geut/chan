{
  "name": "@geut/chan-stringify",
  "version": "3.2.7",
  "description": "Stringify chast to keepachangelog markdown",
  "homepage": "http://geutstudio.com",
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/src/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "module": "./dist/src/index.js",
    "exports": {
      ".": {
        "import": "./dist/src/index.js",
        "types": "./dist/src/index.d.ts"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "lint": "oxlint",
    "check-types": "tsgo --noEmit",
    "build": "tsgo --build"
  },
  "dependencies": {
    "mdast-util-to-markdown": "^2.1.2",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-select": "^4.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  },
  "author": {
    "name": "GEUT",
    "email": "contact@geutstudio.com"
  },
  "license": "ISC",
  "repository": "https://github.com/geut/chan/tree/master/packages/chan-stringify"
}
