{
  "name": "@geut/chast",
  "version": "4.0.0-beta.0",
  "description": "Unist compatible spec for changelogs and helpers to nodes creation",
  "homepage": "http://geutstudio.com",
  "license": "ISC",
  "author": {
    "name": "GEUT",
    "email": "contact@geutstudio.com"
  },
  "repository": "https://github.com/geut/chan/tree/master/packages/chast",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./actions": {
      "types": "./dist/src/actions.d.ts",
      "default": "./dist/src/actions.js"
    }
  },
  "files": [
    "dist/src/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "test": "vitest run",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check-types": "tsgo --build",
    "build": "tsgo --build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@types/unist": "^3.0.3",
    "semver": "^7.7.4",
    "unist-builder": "^4.0.0"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
