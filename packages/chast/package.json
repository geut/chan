{
  "name": "@geut/chast",
  "version": "3.2.6",
  "description": "Unist compatible spec for changelogs and helpers to nodes creation",
  "homepage": "http://geutstudio.com",
  "license": "ISC",
  "author": {
    "name": "GEUT",
    "email": "contact@geutstudio.com"
  },
  "repository": "https://github.com/geut/chan/tree/master/packages/chast",
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts"
  },
  "files": [
    "dist/src/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "module": "./dist/src/index.js",
    "exports": {
      ".": {
        "import": "./dist/src/index.js",
        "types": "./dist/src/index.d.ts"
      },
      "./actions": {
        "import": "./dist/src/actions.js",
        "types": "./dist/src/actions.d.ts"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "check-types": "tsgo --noEmit",
    "build": "tsgo --build"
  },
  "dependencies": {
    "semver": "^7.7.4",
    "unist-builder": "^4.0.0"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "@types/unist": "^3.0.3",
    "vitest": "^4.1.5"
  }
}
